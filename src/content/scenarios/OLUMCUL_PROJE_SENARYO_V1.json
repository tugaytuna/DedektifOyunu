  "presentation": {
    "intro": {
      "title": "ÖLÜMCÜL PROJE",
      "subtitle": "Bir cinayet. Bir sır. Beş saatlik bir soruşturma.",
      "paragraphs": [
        "Adrian Voss öldü. Veyron Biyoteknoloji’nin güçlü yöneticisi, kendi çalışma odasında son nefesini verdi.",
        "Onu öldüren kişiyi aramalarına gerek yok. Çünkü o kişi sensin.",
        "Kimliğini bilmediğin bir işveren, bu cinayet karşılığında sana büyük bir ödeme vaat etti. Ancak görev yalnızca Adrian’ı ortadan kaldırmak değildi. Şirketin gizli laboratuvarında saklanan araştırma dosyasını da ele geçirmen gerekiyor.",
        "Adrian’ın bedeni henüz bulunmadı. Çalışma odasındasın. Arkanda bıraktığın her iz, ileride sana karşı kullanılabilir. Ve zaman senin lehine işlemiyor."
      ],
      "action": "OPERASYONA BAŞLA"
    },
    "openingBriefing": {
      "title": "CİNAYET MAHALLİ",
      "paragraphs": [
        "Adrian Voss’un çalışma odasındasın. Ceset henüz bulunmadı.",
        "Etrafı incele, kanıtları değerlendir veya hemen ayrıl. Açılışta oyun saati ilerlemez; karar senin.",
        "Karar senin."
      ],
      "action": "ANLADIM"
    },
    "chapterTransition": {
      "title": "BİRKAÇ GÜN SONRA…",
      "paragraphs": [
        "Adrian Voss’un çalışma odasından yükselen ağır koku sonunda fark edildi.",
        "Cesedi bulan kişi, asistanı Elena Brooks oldu. Polis binaya geldi. Bir dedektif soruşturmayı devraldı.",
        "Ve sen, başladığın işi tamamlamak için geri döndün."
      ],
      "action": "SORUŞTURMAYA DEVAM ET"
    },
    "tutorials": {
      "evidence": {
        "title": "KANITLAR",
        "body": "Bulduğun nesneler soruşturmayı etkileyebilir. Bazı kanıtları inceleyebilir, bazılarına müdahale edebilirsin. Her eylemin farklı bir sonucu olabilir."
      },
      "time": {
        "title": "ZAMAN ÖNEMLİ",
        "body": "Bazı işlemler oyun saatini ilerletir. Zaman geçtikçe karakterler hareket eder ve soruşturma gelişir."
      },
      "detective": {
        "title": "DİKKATLİ KONUŞ",
        "body": "Dedektif söylediklerini hatırlar. Daha sonra ortaya çıkan kanıtlar, önceki ifadelerinle karşılaştırılabilir."
